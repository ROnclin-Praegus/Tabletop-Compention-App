{
  "_note": "One list of damage and round cases, run by BOTH app/src/test/.../RuleCasesTest.kt and docs/tests.html. Change a rule: change it here, in DamageResolver.kt and in hero-utils.js. Armor/ward values are the CURRENT amounts. Types: physical, magical, unsaveable.",
  "absorbDamage": [
    { "name": "physical: armor absorbs first, rest hits HP", "type": "physical", "amount": 8,
      "start": {"hp": 20, "boostHp": 0, "armor": 5, "ward": 3, "boostArmor": 0, "boostWard": 0},
      "expect": {"hp": 17, "boostHp": 0, "armor": 0, "ward": 3, "boostArmor": 0, "boostWard": 0} },
    { "name": "physical smaller than armor: HP untouched", "type": "physical", "amount": 2,
      "start": {"hp": 20, "boostHp": 0, "armor": 5, "ward": 3, "boostArmor": 0, "boostWard": 0},
      "expect": {"hp": 20, "boostHp": 0, "armor": 3, "ward": 3, "boostArmor": 0, "boostWard": 0} },
    { "name": "physical: boost armor is used before armor", "type": "physical", "amount": 4,
      "start": {"hp": 20, "boostHp": 0, "armor": 5, "ward": 3, "boostArmor": 2, "boostWard": 0},
      "expect": {"hp": 20, "boostHp": 0, "armor": 3, "ward": 3, "boostArmor": 0, "boostWard": 0} },
    { "name": "magical: ward absorbs, armor untouched", "type": "magical", "amount": 5,
      "start": {"hp": 20, "boostHp": 0, "armor": 5, "ward": 3, "boostArmor": 0, "boostWard": 0},
      "expect": {"hp": 18, "boostHp": 0, "armor": 5, "ward": 0, "boostArmor": 0, "boostWard": 0} },
    { "name": "unsaveable skips armor and ward", "type": "unsaveable", "amount": 4,
      "start": {"hp": 20, "boostHp": 0, "armor": 5, "ward": 3, "boostArmor": 0, "boostWard": 0},
      "expect": {"hp": 16, "boostHp": 0, "armor": 5, "ward": 3, "boostArmor": 0, "boostWard": 0} },
    { "name": "boost HP is lost before HP", "type": "unsaveable", "amount": 5,
      "start": {"hp": 20, "boostHp": 3, "armor": 5, "ward": 3, "boostArmor": 0, "boostWard": 0},
      "expect": {"hp": 18, "boostHp": 0, "armor": 5, "ward": 3, "boostArmor": 0, "boostWard": 0} },
    { "name": "HP never goes below 0", "type": "unsaveable", "amount": 10,
      "start": {"hp": 2, "boostHp": 0, "armor": 5, "ward": 3, "boostArmor": 0, "boostWard": 0},
      "expect": {"hp": 0, "boostHp": 0, "armor": 5, "ward": 3, "boostArmor": 0, "boostWard": 0} }
  ],
  "tickRound": [
    { "name": "round: an enabled effect hurts each round",
      "hero": {"endurance": 5, "currentHp": 30, "effects": [{"id": "p", "name": "Poison", "effectType": "HP_CHANGE_PER_ROUND", "value": -4, "damageType": "unsaveable"}]},
      "expect": {"hp": 26, "effects": [{"id": "p", "roundsRemaining": 0}], "expired": []} },
    { "name": "round: a paused effect does nothing and does not run down",
      "hero": {"endurance": 5, "currentHp": 30, "effects": [{"id": "p", "name": "Poison", "effectType": "HP_CHANGE_PER_ROUND", "value": -4, "damageType": "unsaveable", "roundsRemaining": 3, "isEnabled": false}]},
      "expect": {"hp": 30, "effects": [{"id": "p", "roundsRemaining": 3}], "expired": []} },
    { "name": "round: an effect with one round left still acts, then expires",
      "hero": {"endurance": 5, "currentHp": 30, "effects": [{"id": "p", "name": "Poison", "effectType": "HP_CHANGE_PER_ROUND", "value": -4, "damageType": "unsaveable", "roundsRemaining": 1}]},
      "expect": {"hp": 26, "effects": [], "expired": ["Effect expired: Poison"]} },
    { "name": "round: a dice effect uses the rolled amount",
      "hero": {"endurance": 5, "currentHp": 30, "effects": [{"id": "p", "name": "Poison", "effectType": "HP_CHANGE_PER_ROUND", "value": -4, "damageType": "unsaveable", "isDiceRoll": true}]},
      "diceRolls": {"p": -9},
      "expect": {"hp": 21, "effects": [{"id": "p", "roundsRemaining": 0}], "expired": []} },
    { "name": "round: healing stops at max HP",
      "hero": {"endurance": 5, "currentHp": 30, "effects": [{"id": "r", "name": "Regen", "effectType": "HP_CHANGE_PER_ROUND", "value": 100}]},
      "expect": {"hp": 50, "effects": [{"id": "r", "roundsRemaining": 0}], "expired": []} },
    { "name": "round: Spirit recharges MP up to the max",
      "hero": {"endurance": 5, "currentHp": 30, "intelligence": 5, "spirit": 2, "currentMp": 1},
      "expect": {"hp": 30, "mp": 3, "effects": [], "expired": []} },
    { "name": "round: a boost whose last turn is over is removed",
      "hero": {"endurance": 5, "currentHp": 30, "boostHp": 5, "maxBoostHp": 5, "boostHpTurns": 1},
      "expect": {"hp": 30, "boostHp": 0, "effects": [], "expired": ["Boost HP duration has ended!"]} }
  ]
}
